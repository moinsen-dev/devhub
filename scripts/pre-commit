#!/bin/bash
# DevHub Pre-commit Hook for Rust
# Runs formatting and linting checks before allowing commits
#
# Install: cp scripts/pre-commit .git/hooks/pre-commit && chmod +x .git/hooks/pre-commit
# Or run: ./scripts/install-hooks.sh

set -e

# Colors for output
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m' # No Color

echo -e "${YELLOW}🦀 Running Rust pre-commit checks...${NC}"

# Check if we're in a Rust project
if [ ! -f "Cargo.toml" ]; then
    echo -e "${GREEN}✓ Not a Rust project root, skipping Rust checks${NC}"
    exit 0
fi

# Check if any Rust files are staged
RUST_FILES=$(git diff --cached --name-only --diff-filter=ACM | grep '\.rs$' || true)

if [ -z "$RUST_FILES" ]; then
    echo -e "${GREEN}✓ No Rust files staged, skipping Rust checks${NC}"
    exit 0
fi

echo -e "  Checking Rust files..."

# 1. Check formatting
echo -e "${YELLOW}  → Checking formatting (cargo fmt)...${NC}"
if ! cargo fmt -- --check > /dev/null 2>&1; then
    echo -e "${RED}✗ Formatting check failed!${NC}"
    echo -e "${YELLOW}  Run 'cargo fmt' to fix formatting issues${NC}"
    echo ""
    cargo fmt -- --check 2>&1 | head -30
    exit 1
fi
echo -e "${GREEN}  ✓ Formatting OK${NC}"

# 2. Run clippy
echo -e "${YELLOW}  → Running linter (cargo clippy)...${NC}"
if ! cargo clippy --quiet -- -D warnings 2>&1; then
    echo -e "${RED}✗ Clippy found warnings/errors!${NC}"
    echo -e "${YELLOW}  Fix the issues above before committing${NC}"
    exit 1
fi
echo -e "${GREEN}  ✓ Clippy OK${NC}"

# 3. Run tests (optional - can be slow, uncomment if desired)
# echo -e "${YELLOW}  → Running tests (cargo test)...${NC}"
# if ! cargo test --quiet 2>&1; then
#     echo -e "${RED}✗ Tests failed!${NC}"
#     exit 1
# fi
# echo -e "${GREEN}  ✓ Tests OK${NC}"

echo -e "${GREEN}🦀 All Rust checks passed!${NC}"
exit 0
